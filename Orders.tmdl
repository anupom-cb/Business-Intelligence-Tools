	measure 'Total Sales' = SUM(Orders[Sales])
		formatString: \$#,0
		displayFolder: Measures
		lineageTag: deb4b805-c5a2-5a1a-9f76-91d26d71f4d6

	measure 'Total Profit' = SUM(Orders[Profit])
		formatString: \$#,0
		displayFolder: Measures
		lineageTag: 2a0f587d-c613-5734-b37c-830714f7caec

	measure 'Total Quantity' = SUM(Orders[Quantity])
		formatString: #,0
		displayFolder: Measures
		lineageTag: b903063d-d3a3-5781-801f-cc26ae3a0fed

	measure 'Total Orders' = DISTINCTCOUNT(Orders[Order ID])
		formatString: #,0
		displayFolder: Measures
		lineageTag: da5934ef-b963-55cf-9db2-913b17245ffe

	measure 'Total Customers' = DISTINCTCOUNT(Orders[Customer ID])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 45ef1a16-328b-51a9-b2bd-f4bb087a5176

	measure 'Profit Margin %' = DIVIDE([Total Profit],[Total Sales])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 063e1d2a-c6bf-5951-a13d-37dd349b38dd

	measure 'Avg Discount %' = AVERAGE(Orders[Discount])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: d86d5cf6-9795-51da-8acb-ab91f2be987d

	measure 'Avg Order Value' = DIVIDE([Total Sales],[Total Orders])
		formatString: \$#,0.00
		displayFolder: Measures
		lineageTag: a6365d70-3d61-5f88-b27d-c211cab6da2b

	measure 'Total Shipping Cost' = SUM(Orders[Shipping Cost])
		formatString: \$#,0
		displayFolder: Measures
		lineageTag: a27330d5-66ae-5ce0-8731-8beac53587f6

	measure 'Sales PY' = CALCULATE([Total Sales],SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: \$#,0
		displayFolder: Time Intelligence
		lineageTag: cc364c5d-056c-55c4-9ea9-3898a35ce548

	measure 'Sales YoY %' = DIVIDE([Total Sales]-[Sales PY],[Sales PY])
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: c9600ee5-a695-5852-8fb5-77286029c7a9

	measure 'Returned Orders' = CALCULATE(DISTINCTCOUNT(Orders[Order ID]),TREATAS(VALUES(Returns[Order ID]),Orders[Order ID]))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 62b7c3af-e2c7-527e-b587-a8eaae4215ba

	measure 'Return Rate %' = DIVIDE([Returned Orders],[Total Orders])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 4e05f790-6a50-53d7-856a-ceab3b7061d9

	measure 'Top 10 Customer Sales' = VAR r = RANKX(ALLSELECTED(Orders[Customer Name]),[Total Sales],,DESC,Dense) RETURN IF(r<=10,[Total Sales])
		formatString: \$#,0
		displayFolder: Ranking
		lineageTag: d166e688-2c34-56ba-bb34-02be252ff1d6

	measure 'Alert Year' = MAX('Calendar'[Year])
		formatString: 0
		displayFolder: Alerts
		lineageTag: dd13f84f-532c-50c0-9721-db6dc5e1a82d

	measure 'Sales CY' = VAR ay=MAX('Calendar'[Year]) RETURN CALCULATE([Total Sales],'Calendar'[Year]=ay)
		formatString: \$#,0
		displayFolder: Alerts
		lineageTag: 9bb07646-29c5-5935-8a07-3bfe42e91f77

	measure 'Sales Prior Year' = VAR ay=MAX('Calendar'[Year]) RETURN CALCULATE([Total Sales],'Calendar'[Year]=ay-1)
		formatString: \$#,0
		displayFolder: Alerts
		lineageTag: 0f8d0e4a-117a-5b2c-9d33-b32b429a2166

	measure 'Profit CY' = VAR ay=MAX('Calendar'[Year]) RETURN CALCULATE([Total Profit],'Calendar'[Year]=ay)
		formatString: \$#,0
		displayFolder: Alerts
		lineageTag: b2a7bef6-3cb6-5d09-9ada-5f2930854864

	measure 'Returns CY' = VAR ay=MAX('Calendar'[Year]) RETURN CALCULATE([Returned Orders],'Calendar'[Year]=ay)
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 488e4d19-88c7-5800-96fa-2984f3577974

	measure 'Returns Prior Year' = VAR ay=MAX('Calendar'[Year]) RETURN CALCULATE([Returned Orders],'Calendar'[Year]=ay-1)
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 8eade3ec-df58-5ad8-aa16-a44ae5df8ff2

	measure 'Margin CY' = DIVIDE([Profit CY],[Sales CY])
		formatString: 0.0%
		displayFolder: Alerts
		lineageTag: 292499ab-834a-5915-bd79-0ad85ed714c0

	measure 'Sales YoY Change %' = DIVIDE([Sales CY]-[Sales Prior Year],[Sales Prior Year])
		formatString: 0.0%
		displayFolder: Alerts
		lineageTag: 2251adb0-0a5e-5021-9b71-ce14890d031f

	measure 'Returns Change %' = DIVIDE([Returns CY]-[Returns Prior Year],[Returns Prior Year])
		formatString: 0.0%
		displayFolder: Alerts
		lineageTag: 6dd2355d-a5f8-5a49-902f-ff7d8d47c2d0

	measure 'Margin Threshold' = 0.10
		formatString: 0%
		displayFolder: Alerts
		lineageTag: 6794dea9-9032-5e80-add1-e13e18e6534a

	measure 'Sales Decline Threshold' = -0.15
		formatString: 0%
		displayFolder: Alerts
		lineageTag: d239a7b6-fb64-5b1f-a6be-82cd7faa92aa

	measure 'Returns Increase Threshold' = 0.20
		formatString: 0%
		displayFolder: Alerts
		lineageTag: f89ac9a8-f93f-59e7-9c9e-6d9b59cfb3e7

	measure 'Margin Alert' = IF(ISBLANK([Sales CY]),BLANK(),IF([Margin CY]<[Margin Threshold],"🔴 ALERT","🟢 OK"))
		formatString: @
		displayFolder: Alerts
		lineageTag: 81297609-44b4-51de-8537-a44ba2f16a51

	measure 'Sales Alert' = IF(ISBLANK([Sales YoY Change %]),"⚪ n/a",IF([Sales YoY Change %]<[Sales Decline Threshold],"🔴 ALERT","🟢 OK"))
		formatString: @
		displayFolder: Alerts
		lineageTag: f46df251-4d6f-5519-ba1e-c36b8da565b3

	measure 'Returns Alert' = IF(ISBLANK([Returns Change %]),"⚪ n/a",IF([Returns Change %]>[Returns Increase Threshold],"🔴 ALERT","🟢 OK"))
		formatString: @
		displayFolder: Alerts
		lineageTag: 473edc2c-e6b2-50c6-836a-779aae1dbe3f

	measure 'Active Alerts' = VAR m=IF([Margin CY]<[Margin Threshold],1,0) VAR s=IF([Sales YoY Change %]<[Sales Decline Threshold],1,0) VAR r=IF([Returns Change %]>[Returns Increase Threshold],1,0) RETURN m+s+r
		formatString: 0
		displayFolder: Alerts
		lineageTag: 59b80fb7-0f17-5131-823b-ed9f13d97104

	measure 'Regions Below Margin Target' = COUNTROWS(FILTER(VALUES(Orders[Region]),[Margin CY]<[Margin Threshold]))
		formatString: 0
		displayFolder: Alerts
		lineageTag: 0b452ddc-5497-5046-83c5-eb52810bd723

	hierarchy Geography
		lineageTag: 0e6dd03b-5295-5c28-951a-7d779745c05d
		level Region
			lineageTag: 30d42f19-7e4b-5d98-b8db-d600ca6ca472
			column: Region
		level State
			lineageTag: 146dfb18-e019-5452-a5bd-d849a9a9a594
			column: State
		level City
			lineageTag: ee5deda4-7787-5ef3-9204-cbc925cbde77
			column: City

	hierarchy 'Product Hierarchy'
		lineageTag: 113b7782-99d4-5bcc-8429-dea377e8b85a
		level Category
			lineageTag: e00dcbd6-facc-5d2d-9da1-eee11a20fe71
			column: Category
		level 'Sub-Category'
			lineageTag: 0bd1a01d-44b5-5859-9c79-d5e33a584f0a
			column: 'Sub-Category'
		level 'Product Name'
			lineageTag: ec3c02d1-7fc3-5f3e-9829-69022ee62e02
			column: 'Product Name'

	partition Orders = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(FilePath), null, true),
				    OrdersSheet = Source{[Item="Orders",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(OrdersSheet, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Row ID", Int64.Type},{"Order ID", type text},{"Order Date", type datetime},{"Ship Date", type datetime},{"Ship Mode", type text},{"Customer ID", type text},{"Customer Name", type text},{"Segment", type text},{"City", type text},{"State", type text},{"Country", type text},{"Region", type text},{"Market", type text},{"Product ID", type text},{"Product Name", type text},{"Sub-Category", type text},{"Category", type text},{"Sales", type number},{"Quantity", Int64.Type},{"Discount", type number},{"Profit", type number},{"Shipping Cost", type number},{"Order Priority", type text}}),
				    Cleaned = Table.SelectColumns(Typed, {"Row ID","Order ID","Order Date","Ship Date","Ship Mode","Customer ID","Customer Name","Segment","City","State","Country","Region","Market","Product ID","Product Name","Sub-Category","Category","Sales","Quantity","Discount","Profit","Shipping Cost","Order Priority"})
				in
				    Cleaned

	annotation PBI_ResultType = Table

