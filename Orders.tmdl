table Orders
	lineageTag: c2b31e50-c782-54c6-8087-930ef09274d1

	measure 'Total Sales' = SUM(Orders[Sales])
		formatString: $#,0
		displayFolder: 1 Base KPIs
		lineageTag: f1a0b212-4054-5264-a905-2963b10638da

	measure 'Total Profit' = SUM(Orders[Profit])
		formatString: $#,0
		displayFolder: 1 Base KPIs
		lineageTag: cc273c21-b3f9-5620-9f1f-83111013a733

	measure 'Total Orders' = DISTINCTCOUNT(Orders[Order ID])
		formatString: #,0
		displayFolder: 1 Base KPIs
		lineageTag: 01a14f67-4c1b-5b81-af71-95c2b074ef7c

	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales])
		formatString: 0.0%
		displayFolder: 1 Base KPIs
		lineageTag: ea100fa5-a5f3-5888-8b69-986583af30e2

	measure 'Total Customers' = DISTINCTCOUNT(Orders[Customer Name])
		formatString: #,0
		displayFolder: 1 Base KPIs
		lineageTag: 2972b79f-a5b9-5c1e-a3a4-4ce286968b6c

	measure 'Sales Top 10 Customers' =
			VAR _rank = RANKX(ALLSELECTED(Orders[Customer Name]), [Total Sales], , DESC, Dense)
			RETURN IF(_rank <= 10, [Total Sales])
		formatString: $#,0
		displayFolder: 2 Chart helpers
		lineageTag: 8756eedf-03f1-57e5-ab78-3d19f82b564d

	measure 'SC Sales Actual' = CALCULATE([Total Sales], REMOVEFILTERS(Orders[Category]))
		formatString: $#,0
		displayFolder: 3 Scorecard
		lineageTag: 17393121-fc19-5773-ae4b-19e2dbd63dc9

	measure 'SC Profit Actual' = CALCULATE([Total Profit], REMOVEFILTERS(Orders[Category]))
		formatString: $#,0
		displayFolder: 3 Scorecard
		lineageTag: e4f61178-e9d1-5175-b00b-1f5843dd0d05

	measure 'SC Orders Actual' = CALCULATE([Total Orders], REMOVEFILTERS(Orders[Category]))
		formatString: #,0
		displayFolder: 3 Scorecard
		lineageTag: 678e6fca-8358-5ddc-a65a-07812bdd7d7b

	measure 'SC Sales Target' =
			VAR _regions = CALCULATE(VALUES(Orders[Region]), REMOVEFILTERS(Orders[Category]))
			VAR _years = VALUES(Calendar[Year])
			RETURN
			    CALCULATE(
			        SUM(Targets[Sales Target]),
			        TREATAS(_regions, Targets[Region]),
			        TREATAS(_years, Targets[Year])
			    )
		formatString: $#,0
		displayFolder: 3 Scorecard
		lineageTag: 052eabc0-7b5e-5b35-a937-9291ac454c9e

	measure 'SC Profit Target' =
			VAR _regions = CALCULATE(VALUES(Orders[Region]), REMOVEFILTERS(Orders[Category]))
			VAR _years = VALUES(Calendar[Year])
			RETURN
			    CALCULATE(
			        SUM(Targets[Profit Target]),
			        TREATAS(_regions, Targets[Region]),
			        TREATAS(_years, Targets[Year])
			    )
		formatString: $#,0
		displayFolder: 3 Scorecard
		lineageTag: 972dd7e2-a570-5f10-b46d-8434cf8ea327

	measure 'SC Orders Target' =
			VAR _regions = CALCULATE(VALUES(Orders[Region]), REMOVEFILTERS(Orders[Category]))
			VAR _years = VALUES(Calendar[Year])
			RETURN
			    CALCULATE(
			        SUM(Targets[Orders Target]),
			        TREATAS(_regions, Targets[Region]),
			        TREATAS(_years, Targets[Year])
			    )
		formatString: #,0
		displayFolder: 3 Scorecard
		lineageTag: 4fdedf27-e23b-58dd-a2d1-ded147ed360c

	measure 'SC Sales Ach %' =
			VAR _a = [SC Sales Actual]
			VAR _t = [SC Sales Target]
			RETURN
			    IF(ISBLANK(_t), BLANK(),
			        IF(_t > 0, DIVIDE(_a, _t), IF(_a >= _t, 1, 0)))
		formatString: 0.0%
		displayFolder: 3 Scorecard
		lineageTag: cdaddcf4-5943-52b7-adc8-7fa216edf6b5

	measure 'SC Profit Ach %' =
			VAR _a = [SC Profit Actual]
			VAR _t = [SC Profit Target]
			RETURN
			    IF(ISBLANK(_t), BLANK(),
			        IF(_t > 0, DIVIDE(_a, _t), IF(_a >= _t, 1, 0)))
		formatString: 0.0%
		displayFolder: 3 Scorecard
		lineageTag: 2414dc46-c4be-54d8-9bea-6e47a202a19b

	measure 'SC Orders Ach %' =
			VAR _a = [SC Orders Actual]
			VAR _t = [SC Orders Target]
			RETURN
			    IF(ISBLANK(_t), BLANK(),
			        IF(_t > 0, DIVIDE(_a, _t), IF(_a >= _t, 1, 0)))
		formatString: 0.0%
		displayFolder: 3 Scorecard
		lineageTag: c0c2a3eb-8ba9-5bd2-b2e8-00188a57d440

	measure 'SC Sales Color' =
			VAR _x = [SC Sales Ach %]
			RETURN SWITCH(TRUE(), ISBLANK(_x), "#BDBDBD", _x >= [Threshold Achieved], "#2E7D32", _x >= [Threshold Partial], "#F9A825", "#C62828")
		displayFolder: 3 Scorecard
		lineageTag: 873fd3f5-5905-5741-8f4c-49ab68dc5cdf

	measure 'SC Profit Color' =
			VAR _x = [SC Profit Ach %]
			RETURN SWITCH(TRUE(), ISBLANK(_x), "#BDBDBD", _x >= [Threshold Achieved], "#2E7D32", _x >= [Threshold Partial], "#F9A825", "#C62828")
		displayFolder: 3 Scorecard
		lineageTag: 5fcc72ac-8197-5b8a-a536-51e3162e4867

	measure 'SC Orders Color' =
			VAR _x = [SC Orders Ach %]
			RETURN SWITCH(TRUE(), ISBLANK(_x), "#BDBDBD", _x >= [Threshold Achieved], "#2E7D32", _x >= [Threshold Partial], "#F9A825", "#C62828")
		displayFolder: 3 Scorecard
		lineageTag: 1855876d-fa53-53f0-b1b1-d88715ab06ed

	measure 'Avg Discount %' = AVERAGE(Orders[Discount])
		formatString: 0.0%
		displayFolder: 1 Base KPIs
		lineageTag: 935d6dff-2391-58e3-bec6-52db2f7e0b2b

	measure 'Sales PY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR(Calendar[Date]))
		formatString: $#,0
		displayFolder: 4 Advanced analytics
		lineageTag: 7774e046-a599-5528-a5ec-eaf9913f5c2d

	measure 'Profit PY' = CALCULATE([Total Profit], SAMEPERIODLASTYEAR(Calendar[Date]))
		formatString: $#,0
		displayFolder: 4 Advanced analytics
		lineageTag: 8708e2bf-727c-5103-9888-35528754e8d5

	measure 'Sales YoY %' =
			VAR _py = [Sales PY]
			RETURN IF(NOT ISBLANK(_py), DIVIDE([Total Sales] - _py, _py))
		formatString: 0.0%
		displayFolder: 4 Advanced analytics
		lineageTag: 8c32d8f7-c643-569f-a660-32fe6d178bd7

	measure 'Profit YoY %' =
			VAR _py = [Profit PY]
			RETURN IF(NOT ISBLANK(_py), DIVIDE([Total Profit] - _py, _py))
		formatString: 0.0%
		displayFolder: 4 Advanced analytics
		lineageTag: 3fa26865-a068-5440-bfd1-78b3e8d8641f

	measure 'Sales Share %' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED(Orders)))
		formatString: 0.0%
		displayFolder: 4 Advanced analytics
		lineageTag: 54b0f18c-9a81-51da-ac9c-a7763f4e4b9d

	measure 'Loss from Loss-making Lines' = CALCULATE([Total Profit], Orders[Profit] < 0)
		formatString: $#,0
		displayFolder: 4 Advanced analytics
		lineageTag: f6df6b0d-3ad2-5e5f-bf4f-90757f7d27ab

	measure 'Threshold Achieved' = 1
		formatString: 0%
		displayFolder: 3 Scorecard
		lineageTag: 04eb887b-9912-5b5b-b5ef-aaec53e2efe3

	measure 'Threshold Partial' = 0.8
		formatString: 0%
		displayFolder: 3 Scorecard
		lineageTag: 352add52-2d1d-5fb5-a8a4-7655bce45349

