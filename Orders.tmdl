	column 'Discount Band' =
			SWITCH(TRUE(),
			    Orders[Discount] = 0, "No discount",
			    Orders[Discount] <= 0.2, "0-20%",
			    Orders[Discount] <= 0.3, "20-30%",
			    Orders[Discount] <= 0.5, "30-50%",
			    ">50%")
		dataType: string
		lineageTag: c0b2b401-2231-5b73-9468-e53bb3c9ea0c
		summarizeBy: none
		sortByColumn: 'Discount Band Order'

		annotation SummarizationSetBy = Automatic

	column 'Discount Band Order' =
			SWITCH(TRUE(),
			    Orders[Discount] = 0, 1,
			    Orders[Discount] <= 0.2, 2,
			    Orders[Discount] <= 0.3, 3,
			    Orders[Discount] <= 0.5, 4,
			    5)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fc47e316-eb43-5efe-99cb-861795afb565
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Orders = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolderPath & "Global_Superstore_2018.xlsx"), null, true),
					OrdersSheet = Source{[Item = "Orders", Kind = "Sheet"]}[Data],
					ChangedTypes = Table.TransformColumnTypes(OrdersSheet, {{"Row ID", Int64.Type}, {"Order ID", type text}, {"Order Date", type date}, {"Ship Date", type date}, {"Ship Mode", type text}, {"Customer ID", type text}, {"Customer Name", type text}, {"Segment", type text}, {"Postal Code", Int64.Type}, {"City", type text}, {"State", type text}, {"Country", type text}, {"Region", type text}, {"Market", type text}, {"Product ID", type text}, {"Product Name", type text}, {"Sub-Category", type text}, {"Category", type text}, {"Sales", type number}, {"Quantity", Int64.Type}, {"Discount", type number}, {"Profit", type number}, {"Shipping Cost", type number}, {"Order Priority", type text}})
				in
					ChangedTypes

	annotation PBI_ResultType = Table
