table Targets
	lineageTag: 49b69a78-59eb-5aec-84b9-edd585c3ced9

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 22e56b72-b055-5d8c-9657-ac135aa36429
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Region
		dataType: string
		lineageTag: 068160ce-82e7-5c3e-9d09-028d8f251256
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	column 'Sales Target'
		dataType: double
		formatString: $#,0
		lineageTag: 53b09705-0b5d-5f3a-aad1-fe6ffb4d72f9
		summarizeBy: sum
		sourceColumn: Sales Target

